[
  {
    "source_id": "A-01",
    "speaker_zh_CN": "旁白",
    "zh_CN": "午后的走廊里，一名穿白大褂的女医生正低头翻看影像报告，步子很快。"
  },
  {
    "source_id": "A-02",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「咦？之前好像没见过你……」"
  },
  {
    "source_id": "A-03",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「那个，能打扰一下吗？」"
  },
  {
    "source_id": "A-04",
    "speaker_zh_CN": "旁白",
    "zh_CN": "她像是没听见一样，径直从坂口身边走了过去。"
  },
  {
    "source_id": "A-05",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「……还真是彻底地没听见啊。」"
  },
  {
    "source_id": "A-06",
    "speaker_zh_CN": "路过的护士",
    "zh_CN": "「您在叫御園医生？她是影像科的御園芹香医生。」"
  },
  {
    "source_id": "A-07",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「她一直这么忙吗？」"
  },
  {
    "source_id": "A-08",
    "speaker_zh_CN": "路过的护士",
    "zh_CN": "「报告总是准时出来。至于人嘛……您刚才也见到了。」"
  },
  {
    "source_id": "A-09",
    "speaker_zh_CN": "旁白",
    "zh_CN": "女医生已经消失在走廊尽头。坂口回想了一下，发现自己连自我介绍的机会都没有。"
  },
  {
    "source_id": "B-01",
    "speaker_zh_CN": "旁白",
    "zh_CN": "休息室的一角，御園芹香正一个人研究影像资料。桌上的饮料放得很近，她却连碰都没碰。"
  },
  {
    "source_id": "B-02",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「御園医生吧？上次在走廊见过。我是外科的坂口隆司。」"
  },
  {
    "source_id": "B-03",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「……」"
  },
  {
    "source_id": "B-04",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「你是负责我们科影像会诊的？我一直想找机会——」"
  },
  {
    "source_id": "B-05",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「报告在系统里。片子、所见、结论，全部写了。」"
  },
  {
    "source_id": "B-06",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「我是想先认识一下同事。」"
  },
  {
    "source_id": "B-07",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「需要补充判断，请走正式会诊流程。」"
  },
  {
    "source_id": "B-08",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「总不能连喝杯茶都得填会诊单吧？」"
  },
  {
    "source_id": "B-09",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「那不是我的会诊范围。」"
  },
  {
    "source_id": "B-10",
    "speaker_zh_CN": "旁白",
    "zh_CN": "她已经把谈话结束了。尽管两个人面对面坐着，距离似乎比上次那条走廊还远。"
  },
  {
    "source_id": "C-01",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「朝仓，问你一个人。影像科的御園芹香，你认识吗？」"
  },
  {
    "source_id": "C-02",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「认识呀。我们以前就在一起工作过。」"
  },
  {
    "source_id": "C-03",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「她对所有人都那么冷淡？」"
  },
  {
    "source_id": "C-04",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「御園医生的报告有问题吗？」"
  },
  {
    "source_id": "C-05",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「那倒没有。内容很仔细，标注也很清楚。就是本人完全不想和我讲话。」"
  },
  {
    "source_id": "C-06",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「那她大概已经把该说的都写在报告里了。」"
  },
  {
    "source_id": "C-07",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「……你这是在帮她解释，还是在笑我？」"
  },
  {
    "source_id": "C-08",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「两边都有一点吧。」"
  },
  {
    "source_id": "C-09",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「不过，她不是讨厌认真工作的医生。只是有些事，最好让她自己决定要不要讲。」"
  },
  {
    "source_id": "C-10",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「你和她以前，到底发生过什么？」"
  },
  {
    "source_id": "C-11",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「医生。这句话应该去问御園医生，不是问我。」"
  },
  {
    "source_id": "C-12",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「有时候她会去天台透透气。如果真想和她说话……先想好要问什么，别再拿『喝杯茶』当开场白啦。」"
  },
  {
    "source_id": "C-13",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「你怎么连这个都知道？」"
  },
  {
    "source_id": "C-14",
    "speaker_zh_CN": "朝倉美幸",
    "zh_CN": "「这里可是护士站。消息比检验报告传得还快。」"
  },
  {
    "source_id": "C-15",
    "speaker_zh_CN": "旁白",
    "zh_CN": "朝仓笑着转身继续工作。坂口没问到旧事，却得到了一个比敲会诊系统更有用的地点。"
  },
  {
    "source_id": "D-01",
    "speaker_zh_CN": "旁白",
    "zh_CN": "天台上的风比楼下凉一些。御園芹香独自站在栏杆旁，手里没有影像报告。"
  },
  {
    "source_id": "D-02",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「……你又来了。」"
  },
  {
    "source_id": "D-03",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「原来你认得我。」"
  },
  {
    "source_id": "D-04",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「你在走廊叫过我，在休息室里也来找过我。我总不至于连这种事都记不住。」"
  },
  {
    "source_id": "D-05",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「这么说，上次你真的听见了。」"
  },
  {
    "source_id": "D-06",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「嗯。」"
  },
  {
    "source_id": "D-07",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「……回答得还真干脆。」"
  },
  {
    "source_id": "D-08",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「如果还是来问我喝不喝茶，你可以现在回去。」"
  },
  {
    "source_id": "D-09",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「不，这次是工作上的事。我看了你写的术后影像报告。」"
  },
  {
    "source_id": "D-10",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「哪一份？」"
  },
  {
    "source_id": "D-11",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「你特别标出了术野附近血管走向的那份。正文只有几行，附图倒是做得很细。」"
  },
  {
    "source_id": "D-12",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「外科会不会真的去看，是另外一回事。」"
  },
  {
    "source_id": "D-13",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「我看了。那条血管如果按一般位置处理，很容易看错。」"
  },
  {
    "source_id": "D-14",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「既然看出来了，手术时就别弄错。」"
  },
  {
    "source_id": "D-15",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「你说话真不留情面。」"
  },
  {
    "source_id": "D-16",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「片子不需要我留情面。」"
  },
  {
    "source_id": "D-17",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「说起来，星见的术后复查是不是经常漂亮得有点过分？」"
  },
  {
    "source_id": "D-18",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「我刚来这里时，以为有人把术前和术后的片子贴反了。」"
  },
  {
    "source_id": "D-19",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「然后？」"
  },
  {
    "source_id": "D-20",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「重新核对病历、时间、患者编号。全部对得上。」"
  },
  {
    "source_id": "D-21",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「那不是很好吗？」"
  },
  {
    "source_id": "D-22",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「从医疗结果来说，很好。从影像科医生的精神健康来说，有点难评价。」"
  },
  {
    "source_id": "D-23",
    "speaker_zh_CN": "旁白",
    "zh_CN": "她终于把目光转向坂口。这次既没有绕开他，也没有立刻结束谈话。"
  },
  {
    "source_id": "D-24",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「御園芹香。你知道我的名字了，但我还是正式说一次。」"
  },
  {
    "source_id": "D-25",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「坂口隆司，外科。以后影像有不明白的地方，可以直接来问你吗？」"
  },
  {
    "source_id": "D-26",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「可以。工作上的问题，我会回答。」"
  },
  {
    "source_id": "D-27",
    "speaker_zh_CN": "坂口隆司",
    "zh_CN": "「那工作以外——」"
  },
  {
    "source_id": "D-28",
    "speaker_zh_CN": "御園芹香",
    "zh_CN": "「不用问。」"
  },
  {
    "source_id": "D-29",
    "speaker_zh_CN": "旁白",
    "zh_CN": "芹香转回视线，仿佛刚才只是完成了一次简短会诊。可这回，她至少没有把坂口当成走廊里的空气。"
  }
]
