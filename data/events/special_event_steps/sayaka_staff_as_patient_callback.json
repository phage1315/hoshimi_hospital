        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap02_0010",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「当然啦！手术记录不是你自己写的吗？我可是被你折腾得够呛耶！」",
