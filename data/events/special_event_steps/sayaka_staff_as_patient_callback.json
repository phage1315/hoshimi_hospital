[
  {
    "id": "sayaka_staff_patient_callback_01_main",
    "title": "不见的伤口",
    "background_id": "hallway",
    "start": "sap01_0001",
    "nodes": [
      {
        "id": "sap01_0001",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "早上九点。坂口在走廊里遇见了正在查看病房记录的小夜香。",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0001_next",
            "label": "继续",
            "next": "sap01_0002",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0002",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「早啊，小夜香。」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0002_next",
            "label": "继续",
            "next": "sap01_0003",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0003",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「早上好！坂口医生，今天也要努力工作哦！」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0003_next",
            "label": "继续",
            "next": "sap01_0004",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0004",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「……你还真是精神啊。」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0004_next",
            "label": "继续",
            "next": "sap01_0005",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0005",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「嗯？怎么啦？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0005_next",
            "label": "继续",
            "next": "sap01_0006",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0006",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「对了，上周那台阑尾手术……你现在真的一点影响都没有了？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0006_next",
            "label": "继续",
            "next": "sap01_0007",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0007",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「啊，那个呀？早就好啦！第二天连伤口都看不见了耶！」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0007_next",
            "label": "继续",
            "next": "sap01_0008",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0008",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「……第二天？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0008_next",
            "label": "继续",
            "next": "sap01_0009",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0009",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「对呀！一点疤都没留下。你技术真不错嘛！」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0009_next",
            "label": "继续",
            "next": "sap01_0010",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0010",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「等、等一下。那可是开腹阑尾切除啊！皮肤下面还有那么多层组织呢！」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0010_next",
            "label": "继续",
            "next": "sap01_0011",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0011",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「我知道呀。坂口，那台手术可是你亲自给我做的耶，怎么反倒要我给你解释？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0011_next",
            "label": "继续",
            "next": "sap01_0012",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0012",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「……不是这个问题。」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0012_next",
            "label": "继续",
            "next": "sap01_0013",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0013",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "坂口沉思了一会儿。",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0013_next",
            "label": "继续",
            "next": "sap01_0014",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0014",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「小夜香，你今天有空吗？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0014_next",
            "label": "继续",
            "next": "sap01_0015",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0015",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「有是有……怎么啦？难道想约我出去？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0015_next",
            "label": "继续",
            "next": "sap01_0016",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0016",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「不是。你能不能等会儿去影像科做个腹部超声？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0016_next",
            "label": "继续",
            "next": "sap01_0017",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0017",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「超声？为什么呀？」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0017_next",
            "label": "继续",
            "next": "sap01_0018",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0018",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「我想看看里面恢复得怎么样。光凭外面看不出什么伤口，我实在不太放心。」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0018_next",
            "label": "继续",
            "next": "sap01_0019",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0019",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「好呀！呵呵，坂口医生这么关心我，我当然要配合啦！」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0019_next",
            "label": "继续",
            "next": "sap01_0020",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0020",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「……嗯，麻烦你了。」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0020_next",
            "label": "继续",
            "next": "sap01_0021",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0021",
        "speaker": "actor",
        "speaker_label": "南条小夜香",
        "text": "「那我忙完手头的事就过去。检查完再来找你哦！」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0021_next",
            "label": "继续",
            "next": "sap01_0022",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0022",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "小夜香笑着挥挥手，转身离开。",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0022_next",
            "label": "继续",
            "next": "sap01_0023",
            "requirements": []
          }
        ],
        "expression": "smile",
        "actor_id": "doc_sayaka",
        "outfit": "white_coat"
      },
      {
        "id": "sap01_0023",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "坂口望着她的背影，一时有些出神。",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0023_next",
            "label": "继续",
            "next": "sap01_0024",
            "requirements": []
          }
        ],
        "expression": "neutral",
        "hide_portrait": true
      },
      {
        "id": "sap01_0024",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「……第二天就连疤痕都没有了？这到底是什么恢复速度啊……」",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0024_next",
            "label": "继续",
            "next": "sap01_0025",
            "requirements": []
          }
        ],
        "expression": "neutral",
        "hide_portrait": true
      },
      {
        "id": "sap01_0025",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "当天下午，小夜香按约定完成了腹部超声检查。",
        "background_id": "hallway",
        "choices": [
          {
            "id": "sap01_0025_next",
            "label": "继续",
            "next": "@day_end",
            "requirements": []
          }
        ],
        "expression": "neutral",
        "hide_portrait": true
      }
