        "choices": [
          {
            "id": "continue_station_open",
            "label": "她叫住了我",
            "next": "greeting",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "greeting",
        "speaker": "actor",
        "text": "「医、医生！早、早上好！」",
        "expression": "surprised",
        "choices": [
          {
            "id": "continue_greeting",
            "label": "向本庄护士问好",
            "next": "remember_name",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "remember_name",
        "speaker": "actor",
        "text": "「医生还记得我的名字……」\n「昨天的认识方式比较难忘。」\n「呜……」\n她立刻低下头。",
        "expression": "embarrassed",
        "choices": [
          {
            "id": "continue_remember_name",
            "label": "听她继续说",
            "next": "apology_again",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "apology_again",
        "speaker": "actor",
