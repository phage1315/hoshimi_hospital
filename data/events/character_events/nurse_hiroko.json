        "cg_fit": "contain"
      },
      {
        "id": "collision",
        "speaker": "narrator",
        "expression": "worried",
        "text": "咣当！一个肉色的人影迎面撞进坂口怀里。温暖、柔软，是年轻女人的身体。她踉跄了一下，还想继续向前跑，坂口下意识伸手把她拦腰抱住。",
        "choices": [
          {
            "id": "steady_patient",
            "label": "先扶稳她",
            "next": "exposed_patient",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "portrait_path": "assets/events/character_events/hiroko/chihaya_shy.png"
      },
      {
        "id": "exposed_patient",
        "speaker": "narrator",
        "expression": "worried",
        "text": "一名神色惊恐的年轻女性站在面前。她浑身一丝不挂，只戴着蓝色手术帽；羞耻让她急忙遮住双乳，慌乱中却完全顾不上同样暴露的下身。",
        "choices": [
          {
            "id": "ask_what_happened",
            "label": "询问发生了什么",
            "next": "patient_plea",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "portrait_path": "assets/events/character_events/hiroko/chihaya_shy.png"
      },
      {
        "id": "patient_plea",
        "speaker": "narrator",
        "expression": "worried",
        "text": "女患者喘得几乎说不成句：\n「救、救命！她们要给我开的刀和说好的完全不一样啊！说要把整个肚子切开来……救命，我不要开刀！」",
        "choices": [
          {
            "id": "hear_footsteps_behind",
            "label": "身后的脚步声已经追近",
            "next": "nurses_arrive",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "portrait_path": "assets/events/character_events/hiroko/chihaya_shy.png"
      },
      {
        "id": "nurses_arrive",
        "speaker": "narrator",
        "expression": "worried",
        "text": "两名穿着全套手术服的护士追出门来，一左一右夹住女患者，牢牢抓住她的手臂。\n「患者怎么能从手术台上突然跑掉！？太不像话了！」",
        "choices": [
          {
            "id": "try_to_keep_scene_calm",
            "label": "示意所有人先冷静",
            "next": "patient_resists",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "portrait_path": "assets/events/character_events/hiroko/chihaya_restrained_portrait.png"
      },
      {
        "id": "patient_resists",
        "speaker": "narrator",
        "expression": "worried",
        "text": "女患者拼命向后挣扎，泪水不断从脸颊滚落。\n「不、不要啊！不要拉我回去！我不要开刀啊——！」",
        "choices": [
          {
            "id": "watch_nurses_return",
            "label": "护士仍把她往手术室带",
            "next": "dragged_back",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "portrait_path": "assets/events/character_events/hiroko/chihaya_restrained_portrait.png"
      },
      {
        "id": "dragged_back",
        "speaker": "narrator",
        "expression": "worried",
        "text": "两名护士架住她的双臂，将哭喊不止的女患者带回敞开的手术室。她赤裸的身影很快消失在门后，走廊里只剩下散乱的脚步声。",
        "choices": [
          {
            "id": "notice_following_nurse",
            "label": "还有一名护士留在门外",
            "next": "hiroko_apology",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "portrait_path": "assets/events/character_events/hiroko/chihaya_restrained_portrait.png"
      },
      {
        "id": "hiroko_apology",
        "speaker": "actor",
        "expression": "worried",
        "text": "跟在后面的手术室护士向坂口深深鞠了一躬。\n「非常抱歉，让您撞见这样的场面。她第一次接受手术，害怕是可以理解的……可是从手术台上直接跑出来，实在太夸张了。我们马上把现场处理好。」",
        "choices": [
          {
            "id": "respond_to_apology",
            "label": "让她不必在意",
            "next": "honda_instruction",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "honda_instruction",
        "speaker": "player",
        "expression": "worried",
        "text": "坂口略显尴尬地移开视线。\n「不用在意。她现在情绪太激动了，回去以后把镇静再加一点，安抚好再继续手术。」",
        "choices": [
          {
            "id": "send_them_back",
            "label": "让她赶快回去照看患者",
            "next": "hiroko_return",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "hiroko_return",
        "speaker": "actor",
        "expression": "focused",
        "text": "「明白。我会重新确认她的状态。」\n护士再次低头致意，快步追进手术室。厚重的门在她身后合拢，走廊终于安静下来。",
        "choices": [
          {
            "id": "finish_escape_event",
            "label": "离开手术室门口",
            "next": "@end",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": [
              "hiroko_patient_escape_witnessed",
              "chihaya_identity_hidden"
            ]
          }
        ]
      }
    ],
    "benefit_id": ""
