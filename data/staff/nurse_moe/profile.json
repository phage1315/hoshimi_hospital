  "characterization": {
    "public_persona": "态度认真、待人礼貌的新任门诊护士，做每件事都会用力确认，却常因粗线条和重度近视在意外的地方犯错。",
    "core_traits": [
      "呆萌",
      "认真",
      "粗线条",
      "重度近视",
      "善良"
    ],
    "strengths": [
      "对患者耐心且愿意反复确认",
      "被明确交代任务后会努力执行到底",
      "犯错后会认真复盘并想办法避免重演"
    ],
    "flaws": [
      "摘下眼镜后几乎无法辨认标识",
      "紧张时手忙脚乱",
      "过度认真反而容易忽略最直观的问题"
    ],
    "stress_behavior": "先惊叫、结巴并连续道歉；确认具体任务后会迅速站直，用近乎过度认真的态度照做。",
    "professional_behavior": "门诊护理基础扎实，患者照护温和；手术室经验很少，需要清楚指令与复核，但会主动学习并记录路线和步骤。",
    "relationship_arc": "从令人哭笑不得的更衣室误会开始，在一次次认真弥补小失误的过程中建立可靠感，并逐渐敢在坂口面前承认自己的笨拙。",
    "speech_style": "常用敬语，慌张时重复“诶”“对不起”和否定句；恢复镇定后会像接受重大医嘱一样郑重点头。",
    "ethical_handling": "她的近视和粗心应成为可改善的工作习惯与轻喜剧来源；涉及患者安全时必须通过复核、带教和明确流程控制风险。"
  },
