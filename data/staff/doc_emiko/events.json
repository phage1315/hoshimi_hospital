    "start": "opening",
    "nodes": [
      {
        "id": "opening",
        "speaker": "actor",
        "text": "「御堂医生在忙。她说如果是手术相关的事情，把病例留下就可以了。」",
        "expression": "neutral",
        "choices": [
          {
            "id": "ask_name",
            "label": "追问：她知道是谁找她吗？",
            "next": "asked",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "hide_portrait": true
      },
      {
        "id": "asked",
        "speaker": "player",
        "text": "「她知道是谁找她吗？」",
        "expression": "neutral",
        "choices": [
          {
            "id": "then",
