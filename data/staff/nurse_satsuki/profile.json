  "characterization": {
    "public_persona": "年轻、认真而礼貌的妇科护士，仰慕杉村弘子，希望成为能让患者安心的人；在熟悉的女性同事面前自然，面对男性时明显拘谨。",
    "core_traits": [
      "认真",
      "礼貌",
      "书卷气",
      "敏锐",
      "缺乏自信",
      "善于共情"
    ],
    "strengths": [
      "能从患者动作和措辞中捕捉未说出口的不安",
      "护理观察具体而细致",
      "对女性患者自然可靠",
      "愿意复盘流程并承担责任"
    ],
    "flaws": [
      "面对男性同事时容易僵住、结巴和回避视线",
      "缺乏自信时会低估自己的临床判断",
      "重度近视，摘下眼镜后几乎无法辨认远处细节"
    ],
    "stress_behavior": "先僵住、扶住镜框并缩短回答；一旦注意力转向具体患者问题，就会用清晰的观察重新找回工作节奏。",
    "professional_behavior": "目前以妇科护理为主，尚未取得常规手术室岗位资格；她对围术期护理有明确志向，后续需通过带教与轮转逐步解锁。",
    "relationship_arc": "从把坂口视为会令她紧张的男性同事，逐渐确认他愿意认真听取护理判断；核心成长是承认自己能够成为优秀的折川护士，而不是复制弘子或被坂口‘治好’。",
    "speech_style": "敬语为主；紧张时句子断开并反复修正，进入专业说明后语速趋稳、用词准确。",
    "ethical_handling": "男性恐惧不能写成厌男或无能力工作，也不能让坂口扮演治疗者；她的临床成长、责任承担和边界选择必须保有主体性。"
  },
