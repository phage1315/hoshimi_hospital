          }
        ]
      },
      {
        "id": "rs0_0002",
        "presentation": "authored",
        "speaker": "narrator",
        "actor_id": "nurse_hiroko",
        "text": "坂口走进来时，弘子正和两名年轻护士交谈。两人都穿着整齐的白色护士制服，其中一位说得眉飞色舞，另一位也笑着接话。",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0002",
            "label": "继续",
            "next": "rs0_0003",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "rs0_0003",
        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_hiroko",
        "text": "「啊，坂口医生。来得正好，给您介绍两位同事。」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0003",
            "label": "继续",
            "next": "rs0_0004",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "speaker_label": "杉村弘子"
      },
      {
        "id": "rs0_0004",
        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_hiroko",
        "text": "「这位是岩崎留美。这位是米田栞。以后大家会有不少一起工作的机会。」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0004",
            "label": "继续",
            "next": "rs0_0005",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "speaker_label": "杉村弘子"
      },
      {
        "id": "rs0_0005",
        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_iwasaki_rumi",
        "text": "「您好！我是岩崎留美。请多关照！」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0005",
            "label": "继续",
            "next": "rs0_0006",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "speaker_label": "岩崎留美"
      },
      {
        "id": "rs0_0006",
        "presentation": "authored",
        "speaker": "narrator",
        "actor_id": "nurse_iwasaki_rumi",
        "text": "留美笑容灿烂，十分大方地向坂口打招呼。",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0006",
            "label": "继续",
            "next": "rs0_0007",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "rs0_0007",
        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_iwasaki_rumi",
        "text": "「你就是坂口医生呀！之前就听弘子前辈说起过了。」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0007",
            "label": "继续",
            "next": "rs0_0008",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "speaker_label": "岩崎留美"
      },
      {
        "id": "rs0_0008",
        "presentation": "authored",
        "speaker": "player",
        "actor_id": "nurse_iwasaki_rumi",
        "text": "「是吗？希望不是说我的坏话。」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0008",
            "label": "继续",
            "next": "rs0_0009",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "rs0_0009",
        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_hiroko",
        "text": "「我只是告诉她们，医院来了位外科医生。」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0009",
            "label": "继续",
            "next": "rs0_0010",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "speaker_label": "杉村弘子"
      },
      {
        "id": "rs0_0010",
        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_iwasaki_rumi",
        "text": "「呵呵，前辈真是的，难得有新同事，介绍得也太正经了吧！」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0010",
            "label": "继续",
            "next": "rs0_0011",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "speaker_label": "岩崎留美"
      },
      {
        "id": "rs0_0011",
        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_hiroko",
        "text": "「你倒是一点也不怕生。」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0011",
            "label": "继续",
            "next": "rs0_0012",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "speaker_label": "杉村弘子"
      },
      {
