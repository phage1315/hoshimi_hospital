        "presentation": "authored",
        "speaker": "actor",
        "actor_id": "nurse_iwasaki_rumi",
        "text": "「认识新同事又不是考试，有什么好紧张的嘛。」",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0012",
            "label": "继续",
