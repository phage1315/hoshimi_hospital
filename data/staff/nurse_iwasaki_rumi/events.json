        "presentation": "authored",
        "speaker": "narrator",
        "actor_id": "nurse_hiroko",
        "text": "周一上午，护士站里比平时热闹了一些。",
        "expression": "smile",
        "choices": [
          {
            "id": "continue_0001",
            "label": "继续",
