        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_020",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "朝倉美幸",
        "text": "「我知道你们在等。可是催得再急，也不能把没确认的事情当作确认过了。我们核好以后马上回电。」",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_020",
            "label": "继续",
            "next": "a1_021",
            "effects": {
