        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "坂口递过纸。她看了一眼，发现拿到的是旧版，立刻又伸出手。",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": false,
