      {
        "id": "a1_016",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "朝倉美幸",
        "text": "「手术室我来联系。你负责病房，核完再来告诉我。别两边一起打电话，越打越乱。」",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_016",
            "label": "继续",
            "next": "a1_017",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_017",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "年轻护士",
        "text": "「好！我这就去！」",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": true,
