        "id": "a1_010",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "朝倉美幸",
        "text": "「那就先别推。」",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_010",
            "label": "继续",
            "next": "a1_011",
            "effects": {
