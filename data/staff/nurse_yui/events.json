        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_007",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "朝仓接过纸，先看日期，再看两张单据上的修订时间。",
        "expression": "neutral",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_007",
            "label": "继续",
            "next": "a1_008",
            "effects": {
              "affection": 0,
              "familiarity": 0
