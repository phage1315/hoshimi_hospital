        "id": "a1_001",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "护士站里，朝仓正把几份交班资料整理成一叠。看见坂口走近，她抬起头，笑着向他点了点头。",
        "expression": "smile",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_001",
            "label": "继续",
