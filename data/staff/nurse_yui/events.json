      {
        "id": "a1_012",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "朝倉美幸",
        "text": "「他们等的是准备妥当的患者，不是你手里这张改过时间的纸。」",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": false,
