        "id": "a1_011",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "年轻护士",
        "text": "「咦？可他们说已经在等了……」",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": true,
        "choices": [
