        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_013",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "她说得很平静，却已把刚才的笑容收了起来。年轻护士下意识站直了。",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
