            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_002",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "朝倉美幸",
        "text": "「坂口医生，来得正好。今天手术部那边的交接单，我刚整理到一半——」",
        "expression": "smile",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_002",
            "label": "继续",
            "next": "a1_003",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_003",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "一名年轻护士抱着两张纸快步走来，几乎撞上护士站的柜台。",
        "expression": "smile",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_003",
            "label": "继续",
            "next": "a1_004",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_004",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "年轻护士",
        "text": "「朝仓小姐，不好了！下一台手术临时提前了，手术室催着送人，病房那边却还按原来的安排准备！」",
        "expression": "smile",
        "outfit": "uniform",
        "hide_portrait": true,
        "choices": [
          {
            "id": "continue_004",
            "label": "继续",
            "next": "a1_005",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ]
      },
      {
        "id": "a1_005",
        "presentation": "authored",
        "speaker": "player",
        "speaker_label": "坂口隆司",
        "text": "「手术时间改了？」",
        "expression": "smile",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_005",
            "label": "继续",
            "next": "a1_006",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "actor_id": "nurse_yui"
      },
      {
        "id": "a1_006",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "朝倉美幸",
        "text": "「两张给我看看。」",
        "expression": "neutral",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_006",
            "label": "继续",
