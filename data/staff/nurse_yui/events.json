        "id": "a1_021",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "text": "朝仓放下听筒，把两张单据并排摊在柜台上。坂口站在一旁，看她用笔标出需要重新确认的部分。",
        "expression": "serious",
        "outfit": "uniform",
        "hide_portrait": false,
        "choices": [
          {
            "id": "continue_021",
            "label": "继续",
            "next": "a1_022",
            "effects": {
              "affection": 0,
