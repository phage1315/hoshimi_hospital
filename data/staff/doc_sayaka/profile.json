  "team_dialogue": {
    "assignment": "「助手位？可以啊。先说好，高难度的你最好换专业的人；普通的我能跟。」",
    "intraoperative": "「视野稳定。你这么命令人时还挺帅的——手别停，继续。」",
    "intraoperative_correction": "「收到。这里听你的，我退半步重新确认。」",
    "confirmation": "南条先看完术式与岗位要求，确认没有越过自己的能力边界，才笑着把名字写进助手栏。",
    "role_confirmation": "「助手位确认。需要我补位就说，超出能力我也会直接说。」",
    "stabilize": "「先把生命体征和术野分开看。能处理的逐项处理，别一起慌。」"
  },
  "characterization": {
    "public_persona": "亲近、受欢迎、带一点姐姐感的年轻医生；坦率喜欢男人，也自然融入女性同事群体。她主动且享受暧昧，但不会替别人越过边界，也不会让调情覆盖患者照护。",
    "core_traits": [
      "成熟",
      "开朗",
      "主动",
      "坦率",
      "适应力强",
      "有边界",
      "低戏剧性"
    ],
    "strengths": [
      "基础面广，能在不同科室与岗位间快速补位",
      "擅长缓和紧张气氛并建立合作",
      "清楚自己能做什么，也愿意明确说不能做什么"
    ],
    "flaws": [
      "没有压倒性的专科强项，高难病例必须依赖专科同事",
      "轻松主动的表达偶尔会让初识者误判她的认真程度",
      "被真正直球击中时也会短暂乱掉节奏，并不是永远占上风"
    ],
    "stress_behavior": "压力升高时会减少玩笑、缩短句子并主动确认边界；不会用暧昧或轻佻掩盖患者风险。",
    "professional_behavior": "以综合诊疗和健康管理见长，能承担普通助手与跨科补位；遇到超过资格的操作会明确退让给更合适的人。",
    "relationship_arc": "从交换号码和第一次约会确认彼此有意思，再回到医院建立“可以暧昧，也能把工作做好”的默契；路线轻松、主动、少制造门槛，不依靠悲剧或治愈叙事。",
    "speech_style": "可爱轻熟女式的短句和自然口语，偶尔用“诶？”“哦？”“少来”“行啊”拉近距离；知道自己在撩人，但不是每次都能漂亮收尾。真正被坂口直球击中时会停顿、瞪人、移开视线或先笑出来。",
    "ethical_handling": "她喜欢男人并不等于讨厌女人；她的性感、玩笑和主动都来自成年人的自主选择。不得添加悲惨过去、前任创伤、依附讨好、无边界骚扰、医疗失职或万能天才设定。"
  }
