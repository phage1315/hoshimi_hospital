    "start": "al1a_001",
    "nodes": [
      {
        "id": "al1a_001",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "expression": "neutral",
        "text": "距离预定的划刀时间还有十分钟。坂口隆司核对完手头的术前同意书，刚拐进四楼刷手区，就听见最里侧的感应水龙头已经传来了哗哗的水声。",
        "choices": [
          {
            "id": "continue_al1a_001",
            "label": "继续",
            "next": "al1a_002",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "hide_portrait": true
      },
      {
        "id": "al1a_002",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "expression": "masked_smile",
        "text": "城宮明日香早就站在水池前了。平时散在肩头的长发已经被她利落地尽数收进手术帽里，露出光洁饱满的额角与一双神采奕奕的眼睛。见坂口走近，她弯起眉眼，举着沾满细腻泡沫的小臂朝他晃了晃手肘权当招呼。",
        "choices": [
          {
            "id": "continue_al1a_002",
            "label": "继续",
            "next": "al1a_003",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "event_portraits": [
          {
            "id": "doc_asuka",
            "path": "assets/characters/asuka_lv1_v1/doc_asuka/scrubs/masked_smile.png",
            "x": 985,
            "bottom": 556,
            "width": 320,
            "height": 480
          }
        ]
      },
      {
        "id": "al1a_003",
        "presentation": "authored",
        "speaker": "actor",
        "speaker_label": "城宮明日香",
        "expression": "masked_smile",
        "text": "「来得正好呀，坂口医生。患者刚刚已经接进手术间核对信息了，器械台那边也清点得很顺利哦。」",
        "choices": [
          {
            "id": "continue_al1a_003",
            "label": "继续",
            "next": "al1a_004",
            "effects": {
              "affection": 0,
              "familiarity": 0
            },
            "flags": []
          }
        ],
        "event_portraits": [
          {
            "id": "doc_asuka",
            "path": "assets/characters/asuka_lv1_v1/doc_asuka/scrubs/masked_smile.png",
            "x": 985,
            "bottom": 556,
            "width": 320,
            "height": 480
          }
        ]
      },
      {
        "id": "al1a_004",
        "presentation": "authored",
        "speaker": "narrator",
        "speaker_label": "旁白",
        "expression": "masked_bright",
        "text": "坂口隆司走到相邻的水池前踩开踏板，挤出刷手液，看着身旁动作熟稔的年轻院长，忍不住笑了一下。",
